# Clé API Anthropic (https://platform.claude.com). Laisser vide pour la saisir
# dans l'application (onboarding › Génération IA). Lue en mode développement uniquement.
ANTHROPIC_API_KEY=

JOBSCOUT_DB_PATH=./data/jobscout.db
JOBSCOUT_DOCS_PATH=./data/documents

# France Travail — API officielle (optionnel ; identifiants sur https://francetravail.io).
# Sans ces clés, la source passe par les pages publiques.
# FT_CLIENT_ID=
# FT_CLIENT_SECRET=

# Modèles Claude (optionnel, surcharge des valeurs par défaut)
# JOBSCOUT_MODEL_OPUS=claude-opus-4-8
# JOBSCOUT_MODEL_SONNET=claude-sonnet-5

# Welcome to the Jungle : clé de recherche publique du site, à fournir seulement si elle change
# WTTJ_ALGOLIA_APP=
# WTTJ_ALGOLIA_KEY=
